#include <stdio.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <string.h>
struct message {
    long type;
    char text[100];
};
int main() {
    int id;
    struct message m;
    id = msgget(IPC_PRIVATE, IPC_CREAT | 0666);
    if (id == -1) {
        printf("Message queue error\n");
        return 1;
    }
    m.type = 1;
    strcpy(m.text, "Hello World");
    if (msgsnd(id, &m, strlen(m.text) + 1, 0) == -1) {
        printf("Message sending error\n");
        msgctl(id, IPC_RMID, NULL);
        return 1;
    }
    if (msgrcv(id, &m, sizeof(m.text), 1, 0) == -1) {
        printf("Message receiving error\n");
        msgctl(id, IPC_RMID, NULL);
        return 1;
    }
    printf("Received: %s\n", m.text);
    msgctl(id, IPC_RMID, NULL);
    return 0;
}
