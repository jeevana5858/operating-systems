#include <stdio.h>
int main() {
    int bt[] = {5, 3, 2}, wt[3], tat[3], i;
    float awt = 0, atat = 0;
    wt[0] = 0;
    for (i = 1; i < 3; i++)
        wt[i] = wt[i - 1] + bt[i - 1];
    printf("P\tBT\tWT\tTAT\n");
    for (i = 0; i < 3; i++) {
        tat[i] = wt[i] + bt[i];
        printf("P%d\t%d\t%d\t%d\n", i + 1, bt[i], wt[i], tat[i]);
        awt += wt[i];
        atat += tat[i];
    }
    printf("Average WT = %.2f\n", awt / 3);
    printf("Average TAT = %.2f\n", atat / 3);
    return 0;
}
