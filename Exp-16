#include <stdio.h>

struct Employee {
    int id;
    char name[20];
    float salary;
};

int main()
{
    struct Employee e;
    FILE *fp;
    int i, n, pos;

    fp = fopen("emp.dat", "wb");

    printf("Enter number of employees: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("Enter ID, Name and Salary: ");
        scanf("%d %19s %f", &e.id, e.name, &e.salary);
        fwrite(&e, sizeof(e), 1, fp);
    }
    fclose(fp);

    fp = fopen("emp.dat", "rb");

    printf("Enter employee position: ");
    scanf("%d", &pos);

    fseek(fp, (pos - 1) * sizeof(e), SEEK_SET);

    if(fread(&e, sizeof(e), 1, fp) == 1)
        printf("%d %s %.2f\n", e.id, e.name, e.salary);
    else
        printf("Employee not found");

    fclose(fp);
    return 0;
}
