#include <stdio.h>
int main() {
    int bt[] = {5, 2, 3};
    int p[] = {1, 2, 3};
    int wt[3], tat[3], i, j, t;
    for (i = 0; i < 2; i++) {
        for (j = i + 1; j < 3; j++) {
            if (bt[i] > bt[j]) {
                t = bt[i]; bt[i] = bt[j]; bt[j] = t;
                t = p[i]; p[i] = p[j]; p[j] = t;
            }
        }
    }
    wt[0] = 0;
    for (i = 1; i < 3; i++)
        wt[i] = wt[i - 1] + bt[i - 1];
    printf("P\tBT\tWT\tTAT\n");
    for (i = 0; i < 3; i++) {
        tat[i] = wt[i] + bt[i];
        printf("P%d\t%d\t%d\t%d\n", p[i], bt[i], wt[i], tat[i]);
    }
    return 0;
}
