#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
int main() {
    int a, b, n;
    char buffer[100];
    a = open("input.txt", O_RDONLY);
    if (a < 0) {
        printf("Source file not found\n");
        return 1;
    }
    b = open("output.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
    while ((n = read(a, buffer, sizeof(buffer))) > 0)
        write(b, buffer, n);
    close(a);
    close(b);
    printf("File copied successfully\n");
    return 0;
}
