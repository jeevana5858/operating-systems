#include <stdio.h>
int main() {
    int bt[] = {5, 4, 2};
    int rem[] = {5, 4, 2};
    int wt[3], tat[3];
    int q = 2, time = 0, done, i;
    do {
        done = 1;
        for (i = 0; i < 3; i++) {
            if (rem[i] > 0) {
                done = 0;
                if (rem[i] > q) {
                    time += q;
                    rem[i] -= q;
                } else {
                    time += rem[i];
                    rem[i] = 0;
                    tat[i] = time;
                    wt[i] = tat[i] - bt[i];
                }
            }
        }
    } while (done == 0);
    printf("P\tBT\tWT\tTAT\n");
    for (i = 0; i < 3; i++)
        printf("P%d\t%d\t%d\t%d\n",
               i + 1, bt[i], wt[i], tat[i]);
    return 0;
}
