#include <stdio.h>
int main() {
    int bt[] = {5, 2, 3}, pr[] = {3, 1, 2}, p[] = {1, 2, 3};
    int i, j, t, wt[3], tat[3];
    float awt = 0, atat = 0;
    for (i = 0; i < 2; i++)
        for (j = i + 1; j < 3; j++)
            if (pr[i] > pr[j]) {
                t = pr[i]; pr[i] = pr[j]; pr[j] = t;
                t = bt[i]; bt[i] = bt[j]; bt[j] = t;
                t = p[i]; p[i] = p[j]; p[j] = t;
            }
    wt[0] = 0;
    for (i = 1; i < 3; i++)
        wt[i] = wt[i - 1] + bt[i - 1];
    printf("P\tBT\tPR\tWT\tTAT\n");
    for (i = 0; i < 3; i++) {
        tat[i] = wt[i] + bt[i];
        printf("P%d\t%d\t%d\t%d\t%d\n", p[i], bt[i], pr[i], wt[i], tat[i]);
        awt += wt[i];
        atat += tat[i];
    }
    printf("Average WT = %.2f\n", awt / 3);
    printf("Average TAT = %.2f\n", atat / 3);
    return 0;
}
