#include <stdio.h>
int main() {
    int b[5] = {100, 500, 200, 300, 600};
    int p[4] = {212, 417, 112, 426};
    int i, j, best, worst;
    printf("Process\tFirst Fit\tBest Fit\tWorst Fit\n");
    for (i = 0; i < 4; i++) {
        best = -1;
        worst = -1;
        for (j = 0; j < 5; j++) {
            if (b[j] >= p[i]) {
                if (best == -1 || b[j] < b[best])
                    best = j;
                if (worst == -1 || b[j] > b[worst])
                    worst = j;
            }
        }
        printf("%d\t", p[i]);
        for (j = 0; j < 5; j++) {
            if (b[j] >= p[i]) {
                printf("%d\t", j + 1);
                b[j] -= p[i];
                break;
            }
        }
        if (j == 5)
            printf("Not allocated\t");
        printf("%d\t", best == -1 ? 0 : best + 1);
        printf("%d\n", worst == -1 ? 0 : worst + 1);
    }
    return 0;
}
