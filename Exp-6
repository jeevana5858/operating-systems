#include <stdio.h>
int main() {
    int bt[]={5,2,3}, rem[]={5,2,3}, pr[]={3,1,2};
    int wt[3], tat[3], i, k, time=0, done=0;
    while (done < 3) {
        k = -1;
        for (i=0; i<3; i++)
            if (rem[i]>0 && (k==-1 || pr[i]<pr[k]))
                k=i;
        rem[k]--;
        time++;
        if (rem[k]==0) {
            done++;
            tat[k]=time;
            wt[k]=tat[k]-bt[k];
        }
    }
    printf("P\tBT\tPR\tWT\tTAT\n");
    for (i=0; i<3; i++)
        printf("P%d\t%d\t%d\t%d\t%d\n",
               i+1, bt[i], pr[i], wt[i], tat[i]);
    return 0;
}
